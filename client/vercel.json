{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.lortpoc.com/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.lortpoc.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.lortpoc.com/robots.txt"
    },
    {
      "source": "/preview",
      "destination": "https://api.lortpoc.com/preview"
    },
    {
      "source": "/share",
      "destination": "https://api.lortpoc.com/share"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
