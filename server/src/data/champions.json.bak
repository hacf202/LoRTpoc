    "translations": {
      "en": {
        "description": "-Annie mạnh mẽ khi có khả năng gây sát thương vào nhà chính của đối thủ nhờ vào các kỹ năng và bài phép được cường hóa sát thương từ sức mạnh Hỏa Cuồng.\\n-Có khả năng choáng, rút bài, gây sát thương thẳng vào nhà chính bằng các bài quân tiêu hao thấp giúp cho Annie là 1 vị tướng dễ chơi và dễ triển khai.\\n-Annie phù hợp với các sức mạnh cường hóa sát thương từ bài phép và kỹ năng, các cổ vật như Đại Bác, Bão Tố Lunden, Pháo Mũi Tàu Dreadway cho Annie gây lượng lớn sát thương ngay từ giai đoạn đầu trận đấu.",
        "descriptionRaw": "-Annie mạnh mẽ khi có khả năng gây sát thương vào nhà chính của đối thủ nhờ vào các kỹ năng và bài phép được cường hóa sát thương từ sức mạnh Hỏa Cuồng.\\n-Có khả năng choáng, rút bài, gây sát thương thẳng vào nhà chính bằng các bài quân tiêu hao thấp giúp cho Annie là 1 vị tướng dễ chơi và dễ triển khai.\\n-Annie phù hợp với các sức mạnh cường hóa sát thương từ bài phép và kỹ năng, các cổ vật như Đại Bác, Bão Tố Lunden, Pháo Mũi Tàu Dreadway cho Annie gây lượng lớn sát thương ngay từ giai đoạn đầu trận đấu.",
        "name": "Annie",
        "regions": [
          "Noxus"
        ]
      }
    }
