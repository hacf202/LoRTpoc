    },
    "relicSets": [
      {
        "title": "Bộ 1",
        "recommendedStars": 3,
        "items": [
          "R0020",
          "R0048",
          "R0080"
        ],
        "description": "[r:R0020|Kế Đối Phó Của Đại Tướng] tạo sẵn bài phép tướng mỗi vòng giúp bạn vừa dọn quân địch vừa tích Xu, [r:R0048|Máy Sao Chép Hóa Kỹ] nhân đôi bài phép khi đạt 6 mana, và [r:R0080|Quái Thú Bên Trong] trao đặc điểm Áp Đảo cho toàn đội hình đấm tối ưu sát thương.",
        "videoLink": "",
        "translations": {
          "en": {
            "title": "Set 1",
            "description": "[r:R0020|The Grand General's Counterplan] generates a champion spell each round, allowing you to control the enemy board while stacking Coins. [r:R0048|Chemtech Duplicator] doubles your spells once you reach 6 mana, and [r:R0080|The Beast Within] grants your entire board [k:SpellOverwhelm|Overwhelm] to maximize your damage output for lethal.",
            "descriptionRaw": "The Grand General's Counterplan generates a champion spell each round, allowing you to control the enemy board while stacking Coins. Chemtech Duplicator doubles your spells once you reach 6 mana, and The Beast Within grants your entire board Overwhelm to maximize your damage output for lethal."
          }
        }
      },
      {
        "title": "Bộ 2",
        "recommendedStars": 3,
        "items": [
          "R0001",
          "R0045",
          "R0013"
        ],
        "description": "Lối xây dựng cổ vật hiếm dễ dùng. [r:R0001|Di Sản Crownguard] ban lượt tiến công ngay khi Jack hồi đủ năng lượng thăng cấp, [r:R0045|Mảnh Sao Biến Đổi] cho phép Jack nuốt bài quân để lấy chỉ số, và [r:R0013|Quyền Trượng Thiên Thần] hồi năng lượng bài phép mỗi vòng để kích hoạt nội tại tăng sức mạnh.",
        "videoLink": "",
        "translations": {
          "en": {
            "title": "Set 2",
            "description": "An easy-to-use Rare Relic setup. [r:R0001|Crownguard Inheritance] triggers a Rally the moment Jack refills enough mana to level up. [r:R0045|Corrupted Star Fragment] allows Jack to consume an ally to absorb its stats, while [r:R0013|Archangel's Staff] refills your spell mana each round to consistently trigger your passive power and buff your units.",
            "descriptionRaw": "An easy-to-use Rare Relic setup. Crownguard Inheritance triggers a Rally the moment Jack refills enough mana to level up. Corrupted Star Fragment allows Jack to consume an ally to absorb its stats, while Archangel's Staff refills your spell mana each round to consistently trigger your passive power and buff your units."
          }
        }
      }
    ],
