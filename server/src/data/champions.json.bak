  {
    "championID": "C006",
    "name": "Ahri Chiêu Hồn Thiên Hồ",
    "cardCode": "98SB020",
    "regions": [
      "Spiritblossom",
      "Ionia"
    ],
    "cost": 4,
    "tier": "B+ Tier // Sát thương tốt và hồi năng lượng ",
    "maxStar": 7,
    "optimalStars": "4 Sao + Sao Ngọc",
    "playStyle": "Cân bằng / Cảm tử",
    "tags": [
      "Cảm tử",
      "Dàn quân",
      "Chỉ số cao",
      "Hồi năng lượng"
    ],
    "description": "[c:C006|Ahri Chiêu Hồn Thiên Hồ] nổi bậc với lối chơi đánh xoay quanh bài quân cảm tử là [cd:98SB007|Lửa Hồ Ly].\nNhờ việc triệu hồi được rất nhiều [cd:98SB007|Lửa Hồ Ly] thông qua việc sử dụng bài phép 1 tiêu hao trở lên với chỉ số phụ thuộc vào tiêu hao bài phép bạn sử dụng. \n[cd:98SB020|Ahri Chiêu Hồn Thiên Hồ] có khả năng đánh nhanh thắng nhanh khi kết hợp cũng các cổ vật tăng chỉ số và ban [k:SpellOverwhelm|Áp Đảo] như [r:R0080|Quái Thú Bên Trong], [r:R0091|Sức Mạnh Khỉ Đá], [r:R0079|Linh Hồn Buhru], [r:R0116|Bộ Bài Đầy Ắp].\n[cd:98SB020|Ahri Chiêu Hồn Thiên Hồ] còn có cả Ngọc bổ trợ đầy mạnh mẽ hỗ trợ cho lối chơi này là [p:P0857|Giáp Linh Hồn] khi bạn combo cùng với cổ vật [r:R0091|Sức Mạnh Khỉ Đá] hoặc [p:P0891|Bí Mật Linh Hồn] cho các bài quân cảm tử được gấp đôi chỉ số từ mọi nguồn.",
    "descriptionRaw": "Ahri Chiêu Hồn Thiên Hồ nổi bậc với lối chơi đánh xoay quanh bài quân cảm tử là Lửa Hồ Ly.\nNhờ việc triệu hồi được rất nhiều Lửa Hồ Ly thông qua việc sử dụng bài phép 1 tiêu hao trở lên với chỉ số phụ thuộc vào tiêu hao bài phép bạn sử dụng. \nAhri Chiêu Hồn Thiên Hồ có khả năng đánh nhanh thắng nhanh khi kết hợp cũng các cổ vật tăng chỉ số và ban Áp Đảo như Quái Thú Bên Trong, Sức Mạnh Khỉ Đá, Linh Hồn Buhru, Bộ Bài Đầy Ắp.\nAhri Chiêu Hồn Thiên Hồ còn có cả Ngọc bổ trợ đầy mạnh mẽ hỗ trợ cho lối chơi này là Giáp Linh Hồn khi bạn combo cùng với cổ vật Sức Mạnh Khỉ Đá hoặc Bí Mật Linh Hồn cho các bài quân cảm tử được gấp đôi chỉ số từ mọi nguồn.",
    "assets": [
      {
        "avatar": "https://images.lortpoc.com/avatarChampions/SpiritBlossomAhri.webp",
        "fullAbsolutePath": "https://dd.b.pvp.net/6_8_0/tpoc/vi_vn/img/cards/98SB020-full.png",
        "gameAbsolutePath": "https://dd.b.pvp.net/6_8_0/tpoc/vi_vn/img/cards/98SB020.png"
      }
    ],
    "coreRelics": {
      "mandatory": [
        "R0080"
      ],
      "options": [
        [
          "R0116",
          "R0091"
        ],
        [
          "R0116",
          "R0092"
        ]
      ],
      "description": "[r:R0080|Quái Thú Bên Trong] khá quan trọng cho Ahri Hoa Linh vì tướng chủ yếu đánh bằng bài quân.\n[r:R0116|Bộ Bài Đầy Ắp] cho thêm chỉ số dựa trên số lá bài có trong bộ bài, dùng [r:R0091|Sức Mạnh Khỉ Đá] sẽ gây sát thương bằng máu kết hợp cùng ngọc [p:P0857|Giáp Linh Hồn] sẽ cực kỳ hiệu quả.\n[r:R0116|Bộ Bài Đầy Ắp] kèm [r:R0092|Kéo Cắt Ma Quái] nhân đôi bài quân cảm tử kết hợp cực tốt với khả năng của của Ahri.",
      "translations": {
        "en": {
          "description": "[r:R0080|The Beast Within] is highly important for Ahri, as her playstyle relies heavily on unit combat and board presence.\n\n[r:R0116|Stacked Deck] grants bonus stats based on the number of cards in your deck. When paired with [r:R0091|Strength of Stone], your units will strike using their Health ([k:Formidable|Formidable]). This setup becomes incredibly effective when combined with the [p:P0857|Spirit Armor] node to stack massive Health pools.\n\nAlternatively, pairing [r:R0116|Stacked Deck] with [r:R0092|Spectral Scissors] allows you to duplicate an [k:Ephemeral|Ephemeral] attacking unit, creating a massive board state that synergizes perfectly with Ahri's abilities."
        }
      }
    },
    "relicSets": [
      {
        "recommendedStars": 4,
        "items": [
          "R0116",
          "R0091",
          "R0080"
        ],
        "description": "[r:R0091|Sức Mạnh Khỉ Đá] giúp quân có thêm máu và [k:Formidable|Đáng Gờm] giúp quân của bạn đánh bằng máu, cộng thêm ngọc [p:P0857|Giáp Linh Hồn] cho thêm 3 máu nữa quân của bạn sẽ có chỉ số cực tốt ngay khi vừa triệu hồi, [r:R0092|Kéo Cắt Ma Quái] sẽ nhân đôi quân và [r:R0045|Mảnh Sao Biến Đổi] sẽ hấp thụ chỉ số của quân được hỗ trợ giúp cho Ahri khỏe hơn thay vì việc quân cảm tử ra đòn và tự chết. Lưu ý [r:R0092|Kéo Cắt Ma Quái] phải được đặt trên [r:R0045|Mảnh Sao Biến Đổi] để combo có thể hoạt động được.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "[r:R0091|Stone Monkey Strength] grants your units extra health, and the [k:Formidable|Formidable] keyword allows them to strike using their health. Combined with the [p:P0857|Spirit Armor] Constellation upgrade which provides an additional 3 health, your units will have excellent stats right upon being summoned. [r:R0092|Spectral Scissors] will duplicate the unit, and [r:R0045|Corrupted Star Fragment] will absorb the supported unit's stats, making Ahri stronger instead of having the Ephemeral unit strike and die on its own.\n\nNote that [r:R0092|Spectral Scissors] must be placed above [r:R0045|Corrupted Star Fragment] in the relic slots for this combo to work.",
            "descriptionRaw": "Stone Monkey Strength grants your units extra health, and the Formidable keyword allows them to strike using their health. Combined with the Spirit Armor Constellation upgrade which provides an additional 3 health, your units will have excellent stats right upon being summoned. Spectral Scissors will duplicate the unit, and Corrupted Star Fragment will absorb the supported unit's stats, making Ahri stronger instead of having the Ephemeral unit strike and die on its own.\n\nNote that Spectral Scissors must be placed above Corrupted Star Fragment in the relic slots for this combo to work."
          }
        }
      },
      {
        "recommendedStars": 4,
        "items": [
          "R0092",
          "R0116",
          "R0080"
        ],
        "description": "Trong Build này mấu chốt sẽ nằm ở [p:P0891|Bí Mật Linh Hồn] gấp đôi chỉ số từ mọi nguồn cho quân [k:Ephemeral|Cảm Tử], [r:R0140|Linh Hồn Hỗ Trợ] sẽ cho quân cảm tử có [k:SpellOverwhelm|Áp Đảo] kèm theo đó là khi xuất trận Ahri sẽ được thêm 2 bài quân cảm tử nữa, [r:R0116|Bộ Bài Đầy Ắp] sẽ được gấp đôi chỉ số nhận vào nhờ Rune [p:P0891|Bí Mật Linh Hồn]. [r:R0060|Đệ Tử Bóng Đêm] thả Ahri sớm và bạn sẽ có thêm nhiều quân cảm tử.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "In this build, the key lies in the [p:P0891|Spirit's Secret] Rune, which doubles stats from all sources for [k:Ephemeral|Ephemeral] units. [r:R0140|Supportive Spirit] will grant your Ephemeral units [k:SpellOverwhelm|Overwhelm], and additionally, when Ahri is Played, she will summon 2 extra Ephemeral units. The stats provided by [r:R0116|Packed Deck] will be doubled thanks to the [p:P0891|Spirit's Secret] Rune. Finally, [r:R0060|Disciple of Shadows] allows you to drop Ahri early, providing you with even more Ephemeral units on the board.",
            "descriptionRaw": "In this build, the key lies in the Spirit's Secret Rune, which doubles stats from all sources for Ephemeral units. Supportive Spirit will grant your Ephemeral units Overwhelm, and additionally, when Ahri is Played, she will summon 2 extra Ephemeral units. The stats provided by Packed Deck will be doubled thanks to the Spirit's Secret Rune. Finally, Disciple of Shadows allows you to drop Ahri early, providing you with even more Ephemeral units on the board."
          }
        }
      },
      {
        "recommendedStars": 4,
        "items": [
          "R0091",
          "R0092",
          "R0045"
        ],
        "description": "Ahri hấp thụ chỉ số của [cd:98SB007|Lửa Hồ Ly] khi tấn công.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "Ahri absorbs [cd:98SB007|Fox-Fire]'s stats when attacking.",
            "descriptionRaw": "Ahri absorbs Fox-Fire's stats when attacking."
