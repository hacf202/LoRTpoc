    "relicSets": [
      {
        "title": "Bộ 1",
        "recommendedStars": 1,
        "items": [
          "R0082",
          "R0060",
          "R0125"
        ],
        "description": "[r:R0082|Găng Tinh Vân Sư] để thêm ngọc năng lượng, [r:R0060|Đệ Tử Bóng Đêm] giảm tiêu hao cho Sol dựa trên số lượng đồng minh trên sân, dùng để gọi sol sớm hơn, [r:R0125|Lõi Công Nghệ Hoàn Hảo] dùng để kích power giảm 2 tiêu hao cho anh hùng. ",
        "videoLink": ""
      },
      {
        "title": "Bộ 2",
        "recommendedStars": 1,
        "items": [
          "R0125",
          "R0086",
          "R0020"
