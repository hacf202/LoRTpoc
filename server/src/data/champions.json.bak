    "coreRelics": {
      "mandatory": [
        "R0080"
      ],
      "options": [
        [
          "R0147",
          "R0082"
        ],
        [
          "R0113",
          "R0116"
        ],
        [
          "R0116",
          "R0114"
        ]
      ],
      "description": "[r:R0080|Quái Thú Bên Trong] là cổ vật cực kỳ phù hợp với Aatrox, cổ vật cho áp đảo và thêm chi số +1|+1 cho các bài quân có nhóm phụ thường sẽ là cổ vật chính xuất hiện xuyên suốt. xoay quanh đó là các lựa chọn để hợp thành 1 bộ cổ vật như :\n[r:R0147|Quỷ Kiếm Darkin] + [r:R0082|Găng Tinh Vân Sư] cho thêm năng lượng khởi điểm và khả năng ra đòn lên bài quân mỗi khi xuất trận hoặc thức tỉnh Darkin.\n[r:R0113|Sách Ẩn] + [r:R0116|Bộ Bài Đầy Ắp] sẽ cho bài năng lượng lắp trang bị và chỉ số cực nhiều cho quân dựa trên số lượng bài. \n[r:R0116|Bộ Bài Đầy Ắp] + [r:R0114|Khiên Đen] sẽ giúp các bài quân của bạn an toàn trước các hiệu ứng từ bài phép của kẻ địch",
      "translations": {
        "en": {
          "description": "[r:R0080|The Beast Within] is extremely suitable for Aatrox. It grants Overwhelm and +1|+1 to allies with a subtype, making it the core relic used consistently. Built around it are options to complete a full relic build such as:\n[r:R0147|The Darkin Blade] + [r:R0082|Starforged Gauntlets] provides additional starting mana and the ability to strike an enemy unit whenever you play or transform a Darkin.\n[r:R0113|Hidden Tome] + [r:R0116|Stacked Deck] grants equipment mana and immense stats based on your deck size.\n[r:R0116|Stacked Deck] + [r:R0114|Black Shield] keeps your units safe from enemy spells."
        }
      }
    },
    "relicSets": [
      {
        "recommendedStars": 3,
        "items": [
          "R0080",
          "R0040",
          "R0040"
        ],
        "description": "Bộ này cho phép bạn ra đòn 2 lần lên bài quân vừa dọn bàn của kẻ địch còn vừa kích giảm tiêu hao cho các lá bài trên tay và hồi máu cho nhà chính.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "This build allows you to strike twice on enemy units, clearing their board while reducing the cost of cards in hand and healing your Nexus."
          }
        }
      },
      {
        "recommendedStars": 3,
        "items": [
          "R0080",
          "R0082",
          "R0026"
        ],
        "description": "Bộ này lấy 1 ngọc năng lượng để lấy 1 ngọc năng lượng sớm. Để dễ dàng gọi quân và lắp trang bị hơn, không quá phụ thuộc vào tướng. [r:R0080|Quái thú bên trong|icon] để tối ưu sát thương và 1 chút chỉ số.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "This build takes a mana gem to gain early mana, making it easier to summon units and equip darkin weapons without relying too heavily on your champion. [r:R0080|The Beast Within] optimizes damage and stats."
          }
        }
      },
      {
        "recommendedStars": 6,
        "items": [
          "R0080",
          "R0116",
          "R0114"
        ],
        "description": "Bộ cổ vật này vận hành theo kiểu [cd:06RU026|Aatrox|icon] solo carry với việc kế đối phó tạo bài phép anh hùng và [cd:06RU026|Aatrox|icon] sẽ lần lượt dọn bàn bên kia, mỗi lần nhận sát thương sẽ nhận được thêm chỉ số nhờ [r:R0159|Binh Đoàn Vệ Binh|icon], bạn có thể thay thế bằng [r:R0019|Thắt Lưng Cuồng Binh|icon] cũng được, [r:R0049|Mai Giáp Hóa Hư Không|icon] sẽ cho bạn lấy các đặc điểm của bài quân hy sinh, tối ưu nhất sẽ là [k:Lifesteal|hút máu|icon]. Lưu ý bộ cổ vật này tối ưu nhất khi bạn gọi được [cd:06RU026|Aatrox|icon] sớm để vận hành, điều kiện tốt nhất là [cd:06RU026|Aatrox|icon] có vật phẩm [i:I0210|Bùa Xanh|icon] để hồi lại năng lượng sau mỗi lần ra đòn.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "This relic build operates as a solo carry setup for [cd:06RU026|Aatrox], generating champion spells to clear the enemy board while stacking bonus stats via [r:R0159|Strength of Stone] (or [r:R0019|Berserker's Buckle]) each time damage is taken. [r:R0049|Voidborne Carapace] absorbs keywords from sacrificed units, ideally [k:Lifesteal|Lifesteal]. Note that this build excels when [cd:06RU026|Aatrox] is summoned early, especially with [i:I0210|Blue Buff] to restore mana on attack."
          }
        }
      },
      {
        "recommendedStars": 4,
        "items": [
          "R0159",
          "R0049",
          "R0020"
        ],
        "description": "Mai giáp hóa hư không sẽ giữ lại bất tử từ [r:R0007|Thiên Thần Hộ Mệnh|icon], giúp [cd:06RU026|Aatrox|icon] gần như không thể chết được, kết hợp cùng gươm truy tung giúp ra đòn giảm tiêu hao, dọn sàn, hồi máu.",
        "videoLink": "",
        "translations": {
          "en": {
            "description": "[r:R0049|Voidborne Carapace] retains revive from [r:R0007|Guardian Angel], making [cd:06RU026|Aatrox] nearly immortal, combined with Stalker's Blade to strike on summon, reduce darkin cost, clear the board, and heal."
          }
        }
      }
    ],
