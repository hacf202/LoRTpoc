{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/src/data/**,client/dist/**,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/preview",
      "destination": "/api"
    },
    {
      "source": "/share",
      "destination": "/api"
    },
    {
      "source": "/((?!api|sitemap.xml|robots.txt|preview|share).*)",
      "destination": "/index.html"
    }
  ]
}
